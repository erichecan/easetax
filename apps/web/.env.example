# 复制为 .env.local 后填入真实值（.env.local 不提交 git）

# Neon Postgres（dev 暂用美国区；真实客户数据前迁加拿大，PIPEDA）——注意 ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.<region>.aws.neon.tech/easetax?sslmode=require"

# JWT 签名密钥（随机长字符串）
JWT_SECRET="请替换为随机长字符串"

# 一键登录（仅非生产）：登录页出现「一键登录」按钮，免输密码。
# 生产环境（NODE_ENV=production）自动关闭，无需配置；本地想关掉设 DISABLE_DEV_LOGIN=1。
DEV_LOGIN_EMAIL="demo@easetax.ca"
DEV_LOGIN_PASSWORD="easetax-demo"

# QBO refresh token 静态加密密钥（AES-256-GCM）。生成：openssl rand -hex 32
# ⛔ 缺这个就无法连接 QBO（拒绝明文存 token）。生产环境用独立管理的密钥，勿与 JWT_SECRET 复用。
TOKEN_ENCRYPTION_KEY=""

# 原件存储：留空则用本地磁盘 .storage/（仅 dev；生产留空会启动即报错）。
# 生产必填：bucket 建在加拿大区（northamerica-northeast1/2）满足 PIPEDA。
# Cloud Run 走 ADC，无需密钥文件，只要运行服务账号有 roles/storage.objectAdmin。
GCS_BUCKET=""
GCP_PROJECT_ID="supply-491510"

# ---- 外部集成（到对应阶段填；缺失则用 mock provider）----
# P2 OCR — Veryfi（Settings→Keys: app.veryfi.com/api/settings/keys/；见 docs/20260708-veryfi-setup.md）
VERYFI_CLIENT_ID=""
VERYFI_API_KEY=""
VERYFI_USERNAME=""
VERYFI_CLIENT_SECRET=""   # HMAC 签名用（若账号强制签名）

# P3 分类 — Claude（缺失走 mock）
ANTHROPIC_API_KEY=""

# P5 录入 — Intuit QBO sandbox（缺失走 mock）
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/clients/callback"
QBO_ENVIRONMENT="sandbox"

# 邮件入站 webhook 签名密钥（P1）
INBOUND_WEBHOOK_SECRET=""
